{
  "_version": "1.73.1",
  "sap.app": {
    "id": "zmesconfmass.zmesconfmass",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "Tömeges gyártás lejelentés",
    "description": "Tömeges gyártás lejelentés",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:feop",
      "version": "1.29.0",
      "toolsId": "1bd34af4-29d1-47ca-b667-663055c9d044"
    },
    "crossNavigation": {
      "inbounds": {
        "ZmesMassConf-confirm": {
          "semanticObject": "ZmesMassConf",
          "action": "manage",
          "title": "Tömeges gyártás lejelentés",
          "subTitle": "Tömeges gyártás lejelentés",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_mes_pp_massconf_v4/srvd/sap/zui_mes_pp_massconf/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.10",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zmesconfmass.zmesconfmass.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": "Session({key}):?query:",
          "name": "SessionObjectPage",
          "target": "SessionObjectPage"
        },
        {
          "pattern": "Session({key})/_Operations({key2}):?query:",
          "name": "OperationObjectPage",
          "target": "OperationObjectPage"
        }
      ],
      "targets": {
        "SessionObjectPage": {
          "type": "Component",
          "id": "SessionObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Session",
              "content": {
                "header": {
                  "visible": true,
                  "anchorBarVisible": false
                }
              },
              "navigation": {
                "_Operations": {
                  "detail": {
                    "route": "OperationObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "_Operations/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "selectionMode": "Multi",
                    "enableExport": false
                  },
                  "actions": {
                    "scanBarcode": {
                      "press": "zmesconfmass.zmesconfmass.ext.controller.ScanHandler.onScanBarcode",
                      "text": "Beolvasás",
                      "enabled": true
                    },
                    "deleteRow": {
                      "press": "zmesconfmass.zmesconfmass.ext.controller.ScanHandler.onDeleteRow",
                      "text": "Törlés",
                      "enabled": true
                    }
                  }
                }
              }
            }
          }
        },
        "OperationObjectPage": {
          "type": "Component",
          "id": "OperationObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Session/_Operations"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "zmesconfmass.zmesconfmass.ext.controller.SessionObjectPageExt"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}